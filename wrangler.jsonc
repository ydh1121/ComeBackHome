{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "come-back-home-runtime",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-06",
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "PUSH_DELIVERY_ENABLED": "0",
    "PROVIDER_RUNTIME_ENABLED": "0",
    "MUTATIONS_ENABLED": "1",
    "VAPID_PUBLIC_KEY": "BBzKRsrpKTcyhF859UOU7bp_wVU_ww-CKGVCOTqyETNvautMz1icV7lwqcGYkb9qNOPtpYkRFG24o5fwINu46H8",
    "VAPID_SUBJECT": "https://come-back-home-runtime.ydh1121.workers.dev/",
    "WEB_PUSH_TTL_SECONDS": "300",
    "NOTIFICATION_RETRY_DELAYS_SECONDS": "30,90,300"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "come-back-home-db",
      "database_id": "5b5d6397-042c-465b-8411-9e67555eaeb4",
      "migrations_dir": "db/migrations"
    }
  ]
}
