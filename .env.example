# ComeBackHome environment contract
# Copy to .env.local or your preferred local secret file.
# Never commit real secret values.

# Server/runtime secrets
KAKAO_REST_API_KEY=
VAPID_PRIVATE_KEY=
PRESENCE_EVENT_INGEST_TOKEN=

# Server/runtime public/config values
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:YOUR_EMAIL@example.com
WEB_PUSH_TTL_SECONDS=300
NOTIFICATION_RETRY_DELAYS_SECONDS=30,90,300

# Keep disabled until explicit live activation approval.
PROVIDER_RUNTIME_ENABLED=0
PUSH_DELIVERY_ENABLED=0

# Vite build-time runtime selection.
# Keep mock until Worker + D1 + provider activation is ready.
VITE_CBH_RUNTIME=mock
VITE_CBH_PROVIDER_RUNTIME=mock

# Vite build-time public key.
# In production this must equal VAPID_PUBLIC_KEY.
VITE_CBH_VAPID_PUBLIC_KEY=
