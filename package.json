{
  "name": "comebackhome",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:ui-contracts": "node scripts/verify-phase3-ui.mjs",
    "verify:today": "node scripts/verify-phase4a-today.mjs",
    "verify:schedule": "node scripts/verify-phase4b-schedule.mjs",
    "verify:import": "node scripts/verify-phase4c-import.mjs",
    "verify:people": "node scripts/verify-phase4d-people.mjs",
    "verify:commute": "node scripts/verify-phase4e-commute.mjs",
    "verify:notifications": "node scripts/verify-phase4f-notifications.mjs",
    "verify:runtime": "node scripts/verify-phase4g-runtime.mjs",
    "verify:pwa": "node scripts/verify-phase5a-pwa.mjs",
    "verify:push": "node scripts/verify-phase5b-push.mjs",
    "verify:push-client": "node scripts/verify-phase5c-push-client.mjs",
    "verify:backend": "node scripts/verify-phase5d-backend.mjs",
    "check": "npm run typecheck && npm run verify:architecture && npm run verify:ui-contracts && npm run verify:today && npm run verify:schedule && npm run verify:import && npm run verify:people && npm run verify:commute && npm run verify:notifications && npm run verify:runtime && npm run verify:pwa && npm run verify:push && npm run verify:push-client && npm run verify:backend"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.8.3",
    "vite": "8.3.2"
  }
}
