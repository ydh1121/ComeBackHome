{
  "name": "comebackhome",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:ui-contracts": "node scripts/verify-phase3-ui.mjs",
    "check": "npm run typecheck && npm run verify:architecture && npm run verify:ui-contracts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.8.3",
    "vite": "8.3.2"
  }
}
